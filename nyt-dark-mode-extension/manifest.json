{
  "manifest_version": 3,
  "name": "NYT Games Plus — Dark Mode & Spelling Bee Helper",
  "version": "1.0.0",
  "description": "Per-game dark modes for NYT Wordle, Connections, Strands, Mini & Spelling Bee, plus live rank progress and hints for Spelling Bee.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.nytimes.com/*"],
  "action": {
    "default_title": "NYT Games Plus",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nytimes.com/puzzles/spelling-bee*",
        "https://www.nytimes.com/games/connections*",
        "https://www.nytimes.com/games/strands*",
        "https://www.nytimes.com/games/wordle/*",
        "https://www.nytimes.com/crosswords/game/mini*"
      ],
      "css": [
        "src/styles/common.css",
        "src/styles/spelling-bee.css",
        "src/styles/connections.css",
        "src/styles/strands.css",
        "src/styles/mini.css",
        "src/styles/wordle.css"
      ],
      "js": ["src/settings.js", "src/darkmode.js", "src/spelling-bee.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.nytimes.com/puzzles/spelling-bee*"],
      "js": ["src/sb-bridge.js"],
      "world": "MAIN",
      "run_at": "document_end"
    }
  ]
}
